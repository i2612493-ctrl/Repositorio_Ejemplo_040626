#1. VELOCIDAD FINAL
# Definición de variables iniciales
velocidad_inicial_kmh = 0  # km/h
aceleracion = 0.8         # m/s^2
tiempo = 30                # segundos

# 1. Convertir velocidad inicial a m/s (aunque sea 0, es buena práctica)
# 1 km/h = (1000m / 3600s) = 1/3.6 m/s
velocidad_inicial_ms = velocidad_inicial_kmh / 3.6

# 2. Aplicar la fórmula: vf = vi + a * t
velocidad_final_ms = velocidad_inicial_ms + (aceleracion * tiempo)

# 3. Convertir el resultado de vuelta a km/h para mayor claridad
velocidad_final_kmh = velocidad_final_ms * 3.6

# Mostrar resultados
print(f"Velocidad final en m/s: {velocidad_final_ms:.2f} m/s")
print(f"Velocidad final en km/h: {velocidad_final_kmh:.2f} km/h")
