#4. CÁLCULO DE SUELDO Y COMISIONES
def solicitar_valor(mensaje):
    """Solicita un valor numérico y valida que sea positivo."""
    while True:
        try:
            valor = float(input(mensaje))
            if valor >= 0:
                return valor
            else:
                print('Error: El valor no puede ser negativo.')
        except ValueError:
            print('Error: Por favor, ingresa un número válido.')

# 1. Entrada de datos
print('--- Cálculo de Nómina Mensual ---')
sueldo_base = solicitar_valor('Ingresa tu sueldo base: ')
venta1 = solicitar_valor('Monto de la venta 1: ')
venta2 = solicitar_valor('Monto de la venta 2: ')
venta3 = solicitar_valor('Monto de la venta 3: ')

# 2. Proceso
total_ventas = venta1 + venta2 + venta3
comision = total_ventas * 0.25
total_a_recibir = sueldo_base + comision

# 3. Salida de resultados
print(f'\n--- Resumen del Mes ---')
print(f'Sueldo Base: ${sueldo_base:,.2f}')
print(f'Total en Ventas: ${total_ventas:,.2f}')
print(f'Monto por Comisiones (25%): ${comision:,.2f}')
print(f'Total a recibir en el mes: ${total_a_recibir:,.2f}')
