#6. TIEMPO DE VIDA VIVIDO
def solicitar_edad(mensaje):
    """Solicita la edad y valida que sea un número positivo."""
    while True:
        try:
            valor = float(input(mensaje))
            if valor >= 0:
                return valor
            else:
                print('Error: La edad no puede ser negativa.')
        except ValueError:
            print('Error: Por favor, ingresa un número válido.')

# 1. Entrada de datos
print('--- Calculadora de Tiempo de Vida ---')
edad_años = solicitar_edad('Ingresa tu edad en años: ')

# 2. Proceso (Basado en 1 año = 365 días)
meses = edad_años * 12
semanas = edad_años * 52.143 # Promedio de semanas en un año
dias = edad_años * 365
horas = dias * 24

# 3. Salida de resultados
print(f'\nPara una edad de {edad_años} años, has vivido aproximadamente:')
print(f'- {meses:,.0f} meses')
print(f'- {semanas:,.0f} semanas')
print(f'- {dias:,.0f} días')
print(f'- {horas:,.0f} horas')
