#2. PROMEDIO DE NOTAS
def solicitar_nota(mensaje):
    """Solicita una nota y valida que esté entre 0 y 20."""
    while True:
        try:
            nota = float(input(mensaje))
            if 0 <= nota <= 20:
                return nota
            else:
                print('Error: La calificación debe estar entre 0 y 20. Intenta de nuevo.')
        except ValueError:
            print('Error: Entrada no válida. Por favor, ingresa un número.')

# 1. Entrada de datos validada
print('--- Ingreso de Calificaciones ---')
nota1 = solicitar_nota('Examen 1 (0-20): ')
nota2 = solicitar_nota('Examen 2 (0-20): ')
nota3 = solicitar_nota('Examen 3 (0-20): ')
nota4 = solicitar_nota('Examen 4 (0-20): ')

# 2. Proceso: Calcular el promedio
suma_total = nota1 + nota2 + nota3 + nota4
promedio = suma_total / 4

# 3. Salida de resultados
print(f'\nSuma total de puntos: {suma_total}')
print(f'Promedio final obtenido: {promedio:.2f}')
